# Local Keycloak secrets (P1-T3)
deploy/dev/keycloak.env
# The workers' secrets before P1-T8d2: no longer written (keycloak up deletes them), still
# ignored so that a leftover copy can never be committed
deploy/dev/provisioner.env
deploy/dev/staff-worker.env
# Public signing keys (P1-T8d2; scripts/care-dev.sh keycloak keys): no secrets, but made per
# machine
deploy/dev/client-keys/
deploy/dev/audit-anchor-read.env
deploy/dev/audit-anchor-write.env
deploy/dev/s3-gateway.env
deploy/dev/s3-care.env
# The combined CARE key P1-T20b retired (dead; kept for the live check)
deploy/dev/s3-retired.env

# Staging secrets and site settings (P1-T8a): generated by scripts/staging.sh init
deploy/staging/.env
deploy/staging/.local
deploy/staging/.db-created
deploy/staging/secrets/
deploy/staging/.init.*/
deploy/staging/generated/
# Release log, the release in progress and each release's stack files (P1-T18b)
deploy/staging/releases/
# A single-hospital restore's package while it runs (P1-T22b): personal data, never committed
deploy/staging/restore/

# OpenTofu (P1-T8b4): providers, state, plans and real settings never go into git
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/backend.hcl
infra/**/terraform.tfvars
infra/**/*.auto.tfvars

# Browser specs (P1-T1d): failure screenshots and JSON
apps/frontend/test-results-ihr/
