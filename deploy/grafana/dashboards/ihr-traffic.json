   "title": "Sign-in (from the logs)",
   "type": "row"
  },
  {
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 27
   },
   "id": 10,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "source:=container service:=keycloak kc_event:in(LOGIN_ERROR, USER_DISABLED_BY_TEMPORARY_LOCKOUT, USER_DISABLED_BY_PERMANENT_LOCKOUT) | stats by (kc_event) count() n",
     "legendFormat": "{{kc_event}}",
     "queryType": "statsRange",
     "refId": "A"
    }
   ],
   "title": "Sign-in failures and lock-outs",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "description": "Names addresses, as the alert mails do (Q-O8). Usernames are not shown here.",
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 27
   },
   "id": 11,
   "options": {},
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "source:=container service:=keycloak kc_event:=LOGIN_ERROR kc_error:in(invalid_user_credentials, user_not_found, invalid_user, user_temporarily_disabled, user_disabled) client_ip:* | stats by (client_ip) count() failures | sort by (failures desc) limit 20",
     "queryType": "stats",
     "refId": "A"
    }
   ],
   "title": "Addresses with the most sign-in failures (selected time range)",
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "desc": true,
        "field": "failures"
       }
      ]
     }
    }
   ],
   "type": "table"
  }
 ],
