# IndieHR build-time settings for the CARE web app (P0-T10).
# Sourced by CI before `npm run build`; overrides apps/frontend/.env, which points at OHC.
# REACT_CARE_API_URL is set per build (workflow input / environment).
REACT_APP_TITLE="IndieHR"
REACT_PUBLIC_URL="http://localhost:8080"
REACT_APP_COVER_IMAGE="http://localhost:8080/images/care_logo.svg"
REACT_APP_COVER_IMAGE_ALT="http://localhost:8080/images/care_logo.svg"
REACT_SBOM_BASE_URL="http://localhost:8080/sbom"
REACT_APP_STORE_INDEX_URL=""
REACT_ENABLED_APPS=""
REACT_RECAPTCHA_SITE_KEY=""
REACT_SENTRY_DSN=""
REACT_ALLOWED_LOCALES="en,hi"
