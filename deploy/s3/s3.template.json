{
  "identities": [
    {
      "name": "ihr-s3-admin",
      "credentials": [
        {
          "accessKey": "@ADMIN_KEY@",
          "secretKey": "@ADMIN_SECRET@"
        }
      ],
      "actions": [
        "Admin",
        "Read",
        "Write",
        "List",
        "Tagging"
      ]
    },
    {
      "name": "ihr-care-files",
      "credentials": [
        {
          "accessKey": "@FILES_KEY@",
          "secretKey": "@FILES_SECRET@"
        }
      ],
      "actions": [
        "Read:@PATIENT_BUCKET@",
        "Write:@PATIENT_BUCKET@"
      ]
    },
    {
      "name": "ihr-care-pictures",
      "credentials": [
        {
          "accessKey": "@PICTURES_KEY@",
          "secretKey": "@PICTURES_SECRET@"
        }
      ],
      "actions": [
        "Read:@FACILITY_BUCKET@",
        "Write:@FACILITY_BUCKET@"
      ]
    },
    {
      "name": "ihr-anchor-writer",
      "credentials": [
        {
          "accessKey": "@ANCHOR_WRITE_KEY@",
          "secretKey": "@ANCHOR_WRITE_SECRET@"
        }
      ],
      "policyNames": [
        "ihr-anchor-write"
      ]
    },
    {
      "name": "ihr-anchor-reader",
      "credentials": [
        {
          "accessKey": "@ANCHOR_READ_KEY@",
          "secretKey": "@ANCHOR_READ_SECRET@"
        }
      ],
      "policyNames": [
        "ihr-anchor-read"
      ]
    },
    {
      "name": "ihr-backup",
      "credentials": [
        {
          "accessKey": "@BACKUP_KEY@",
          "secretKey": "@BACKUP_SECRET@"
        }
      ],
      "actions": [
        "Read:@BACKUP_BUCKET@",
        "Write:@BACKUP_BUCKET@",
        "List:@BACKUP_BUCKET@"
      ]
    },
    {
      "name": "ihr-log-archive",
      "credentials": [
        {
          "accessKey": "@LOGS_ARCHIVE_KEY@",
          "secretKey": "@LOGS_ARCHIVE_SECRET@"
        }
      ],
      "policyNames": [
        "ihr-log-archive"
      ]
    },
    {
      "name": "ihr-dumps",
      "credentials": [
        {
          "accessKey": "@DUMPS_KEY@",
          "secretKey": "@DUMPS_SECRET@"
        }
      ],
      "policyNames": [
        "ihr-dumps"
      ]
    }
  ],
  "policies": [
    {
      "name": "ihr-anchor-write",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\"],\"Resource\":[\"arn:aws:s3:::@ANCHOR_BUCKET@/anchors/*\"]}]}"
    },
    {
      "name": "ihr-anchor-read",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:GetObjectVersion\"],\"Resource\":[\"arn:aws:s3:::@ANCHOR_BUCKET@/anchors/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\",\"s3:ListBucketVersions\",\"s3:GetBucketObjectLockConfiguration\",\"s3:GetBucketVersioning\"],\"Resource\":[\"arn:aws:s3:::@ANCHOR_BUCKET@\"]}]}"
    },
    {
      "name": "ihr-log-archive",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\",\"s3:GetObject\",\"s3:GetObjectVersion\"],\"Resource\":[\"arn:aws:s3:::@LOGS_ARCHIVE_BUCKET@/logs/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\"],\"Resource\":[\"arn:aws:s3:::@LOGS_ARCHIVE_BUCKET@/erasure/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\",\"s3:GetBucketObjectLockConfiguration\",\"s3:GetBucketVersioning\"],\"Resource\":[\"arn:aws:s3:::@LOGS_ARCHIVE_BUCKET@\"]}]}"
    },
    {
      "name": "ihr-dumps",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\",\"s3:GetObject\",\"s3:GetObjectVersion\"],\"Resource\":[\"arn:aws:s3:::@DUMPS_BUCKET@/dumps/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\"],\"Resource\":[\"arn:aws:s3:::@DUMPS_BUCKET@/erasure/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\",\"s3:ListBucketVersions\",\"s3:GetBucketObjectLockConfiguration\",\"s3:GetBucketVersioning\"],\"Resource\":[\"arn:aws:s3:::@DUMPS_BUCKET@\"]}]}"
    }
  ]
}
