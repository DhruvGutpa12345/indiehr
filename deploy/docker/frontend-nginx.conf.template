# Based on apps/frontend/nginx/nginx.conf (upstream CARE), adapted for IndieHR:
# non-root port 8080; OHC-specific asset hosts removed; CSP ENFORCED (P0-T10).
# Rendered at container start by the image's envsubst step:
#   CSP_API_ORIGIN      e.g. https://api.example.in   (the CARE API)
#   CSP_STORAGE_ORIGIN  e.g. https://files.example.in (pre-signed file URLs)
#   API_UPSTREAM        e.g. http://backend:9000 — serve the API on the same origin (P1-T2b).
#                       Each hospital's host then reaches its own schema. Empty: /api/ is 404.
#   NGINX_RESOLVER      DNS server for API_UPSTREAM (default 127.0.0.11, Docker's own)
# Access log without query strings (P1-T8a): searches carry patient names and phone numbers,
# and the logs are kept 180 days. The path is enough to trace a request.
log_format ihr_path '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time';
# Behind Traefik the browser's request was https: pass that on, so Django (which trusts this
# header) sees it. Traefik sets the header itself and ignores a client's.
map $http_x_forwarded_proto $ihr_forwarded_proto {
  default $scheme;
  https https;
}

server {
  listen 8080;
  access_log /var/log/nginx/access.log ihr_path;
  root /usr/share/nginx/html;

  server_tokens off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(self), microphone=(self)" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_STORAGE_ORIGIN}; font-src 'self' data:; connect-src 'self' ${CSP_API_ORIGIN} ${CSP_STORAGE_ORIGIN}; media-src 'self' blob: ${CSP_STORAGE_ORIGIN}; worker-src 'self' blob:; frame-src 'self' blob: ${CSP_STORAGE_ORIGIN}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

  include mime.types;
  types {
    text/javascript js mjs;
  }

  # Same-origin API: the browser's Host (the hospital's address) is passed through unchanged,
  # so the backend picks that hospital's schema. Resolved per request: nginx starts without it.
  resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
  set $api_upstream "${API_UPSTREAM}";
  location /api/ {
    if ($api_upstream = "") {
      return 404;
    }
    proxy_pass $api_upstream;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $ihr_forwarded_proto;
    proxy_read_timeout 120s;
    client_max_body_size 10m;
  }

  location = /index.html {
    expires 6h;
  }

  # Translations keep the same file name across releases: revalidate on every load, so a
  # corrected string reaches staff at once (P1-T7c). "expires", not add_header, which would
  # drop the security headers above.
  location /locale/ {
    expires -1;
    try_files $uri =404;
  }

  location / {
    expires 7d;
    try_files $uri $uri/ /index.html;
  }
}
