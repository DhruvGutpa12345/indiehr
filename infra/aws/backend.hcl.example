# Copy to backend.hcl (git-ignored), fill in, then: tofu init -backend-config=backend.hcl
# The state bucket is made once by hand (versioning on, all public access blocked), in India.
bucket       = "indiehr-tofu-state-123456789012"
key          = "aws/staging.tfstate"
region       = "ap-south-1"
use_lockfile = true # S3's own conditional writes: no DynamoDB table needed
