# Copy to terraform.tfvars (git-ignored). Secrets never go here: the state passphrase is
# TF_VAR_state_passphrase; AWS credentials come from AWS_PROFILE or the environment.
account_id           = "123456789012"
name                 = "indiehr-staging"
instance_type        = "t3.large"
ubuntu_release       = "26.04"
ssh_public_key       = "ssh-ed25519 AAAA... owner@laptop"
tenant_domain_suffix = "app.amhcloud.in"
buckets = {
  files    = "indiehr-staging-files-123456789012"
  facility = "indiehr-staging-facility-123456789012"
  backups  = "indiehr-staging-backups-123456789012"
}
